{
  "name": "@spendlease/sdk",
  "version": "0.2.0-beta.2",
  "description": "Thin TypeScript helpers for the spendlease spend authorization gateway",
  "keywords": ["ai", "agents", "spend", "budget", "gateway"],
  "license": "Apache-2.0",
  "homepage": "https://premhiru.github.io/spendlease/",
  "bugs": "https://github.com/premhiru/spendlease/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premhiru/spendlease.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "beta"
  }
}
